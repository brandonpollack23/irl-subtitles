{
  "package_id": "com.brandonpollack.irlsubtitles",
  "name": "IRL Subtitles",
  "version": "0.1.0",
  "edition": "202601",
  "min_sdk_version": "0.0.15",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Downloads on-device speech models from Hugging Face once. Sends conversation audio to Soniox or Speechmatics only for the options you choose in Settings; with Speechmatics voice identification, Speechmatics also keeps voiceprints of people you name.",
      "whitelist": [
        "https://huggingface.co",
        "https://cdn-lfs.huggingface.co",
        "https://cdn-lfs-us-1.hf.co",
        "https://cas-bridge.xethub.hf.co",
        "https://download.moonshine.ai",
        "https://api.soniox.com",
        "wss://stt-rt.soniox.com",
        "https://mp.speechmatics.com",
        "https://eu1.asr.api.speechmatics.com",
        "https://us1.asr.api.speechmatics.com",
        "https://au1.asr.api.speechmatics.com",
        "wss://eu.rt.speechmatics.com",
        "wss://us.rt.speechmatics.com",
        "wss://au.rt.speechmatics.com"
      ]
    }
  ],
  "supported_languages": [
    "en",
    "ja"
  ]
}
